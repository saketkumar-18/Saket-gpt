# SaketGPT works with ANY OpenAI-compatible provider.
# Default: b.ai free tier (qwen3.8-flash). Point it anywhere else instead:
#   OpenAI      -> LLM_BASE_URL=https://api.openai.com/v1        CHAT_MODELS=gpt-4o-mini
#   OpenRouter  -> LLM_BASE_URL=https://openrouter.ai/api/v1     CHAT_MODELS=deepseek/deepseek-chat
#   Ollama      -> LLM_BASE_URL=http://localhost:11434/v1        CHAT_MODELS=llama3.2  (LLM_API_KEY=ollama)
LLM_BASE_URL=https://api.b.ai/v1
LLM_API_KEY=***
CHAT_MODELS=qwen3.8-flash

# Optional: assistant-ui cloud persistence instead of localStorage
# NEXT_PUBLIC_ASSISTANT_BASE_URL=
