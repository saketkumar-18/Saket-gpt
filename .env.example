# SaketGPT works with ANY OpenAI-compatible provider.
# Default: tokenharbor free tier (mimo-v2.5:free). Point it anywhere else:
#   b.ai        -> LLM_BASE_URL=https://api.b.ai/v1        CHAT_MODELS=qwen3.8-flash
#   OpenAI      -> LLM_BASE_URL=https://api.openai.com/v1  CHAT_MODELS=gpt-4o-mini
#   OpenRouter  -> LLM_BASE_URL=https://openrouter.ai/api/v1 CHAT_MODELS=deepseek/deepseek-chat
#   Ollama      -> LLM_BASE_URL=http://localhost:11434/v1  CHAT_MODELS=llama3.2  (LLM_API_KEY=***
LLM_BASE_URL=https://tokenharbor.ai/v1
LLM_API_KEY=***
CHAT_MODELS=mimo-v2.5:free,deepseek-v4-flash:free,mimo-v2.6-flash:free

# Optional: assistant-ui cloud persistence instead of localStorage
# NEXT_PUBLIC_ASSISTANT_BASE_URL=
